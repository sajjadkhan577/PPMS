{
  "name": "ppms",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Petrol Pump Management System",
  "author": "PPMS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.mjs",
    "start": "node server.mjs",
    "dev:all": "node server.mjs",
    "build": "tsc && vite build",
    "electron:dev": "npm run build && electron electron/main.cjs",
    "dist:win": "node scripts/package-windows.mjs",
    "preview": "vite preview",
    "test": "vitest run && node --test electron/runtime-paths-check.cjs && node scripts/test-desktop-server.mjs && node scripts/test-security-api.mjs",
    "desktop:seed": "node scripts/create-desktop-seed.mjs"
  },
  "main": "electron/main.cjs",
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "com.ppms.station",
    "productName": "PPMS",
    "asar": false,
    "files": [
      "dist/**/*",
      "server.mjs",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/runtime-paths.cjs",
      "electron/ppms-icon.ico",
      "electron/ppms-icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-seed/ppms.sqlite",
        "to": "data/ppms.sqlite"
      }
    ],
    "icon": "electron/ppms-icon.ico",
    "win": {
      "icon": "electron/ppms-icon.ico",
      "target": "nsis",
      "artifactName": "PPMS Setup ${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PPMS",
      "uninstallDisplayName": "PPMS",
      "installerIcon": "electron/ppms-icon.ico",
      "uninstallerIcon": "electron/ppms-icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
